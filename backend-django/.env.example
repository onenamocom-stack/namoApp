# Django API environment — copy to .env and fill in. NEVER commit a filled copy.
# All values here are placeholders; production secrets live only in the host's
# secret store (backend/INSTRUCTIONS.md rule 7).

# --- core ---
# Random string: `python -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=
# Comma-separated hostnames; empty means fail loudly in prod settings
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Which settings module: config.settings.local | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.local
# Version string echoed by /v1/health/
API_VERSION=dev
LOG_LEVEL=INFO

# --- database ---
# postgres://user:password@host:5432/dbname[?sslmode=require]
# Empty falls back to sqlite (local/test only — never in prod).
DATABASE_URL=
# Set to swap the cache location seam in; Redis client lands with a later phase
REDIS_URL=

# --- Supabase auth (pick ONE mode) ---
# JWKS mode (current projects): the API verifies RS256/ES256 tokens against
#   https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://your-project-ref.supabase.co
# HS256 mode (legacy projects with a shared JWT secret) — leave SUPABASE_URL
#   empty when using this.
SUPABASE_JWT_SECRET=
# Audience claim to enforce; Supabase default:
SUPABASE_JWT_AUDIENCE=authenticated

# --- CORS ---
# Comma-separated exact origins; the SPA's Pages origin plus localhost dev.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- rate limits (DRF throttle rates) ---
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=600/minute

# --- media / Cloudflare R2 ---
# "local" (dev: fabricated URLs, nothing uploaded) or "r2"
MEDIA_PROVIDER=local
MEDIA_PUBLIC_BASE_URL=https://media.your-domain.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Copy to .env.local and fill in. `.env.local` is gitignored (`*.local`).
#
# These MUST point at the DEV Supabase project, never production.
# Production credentials live only in the GitHub Actions secrets, which the
# deploy workflow reads. See backend/INSTRUCTIONS.md §3.
#
# Vite inlines VITE_* at build time: restart the dev server after editing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay. The key ID is public by design — it ships in the browser bundle.
# The key SECRET and the webhook secret are NOT here: they go in the Supabase
# project's Edge Function secrets. See backend/INSTRUCTIONS.md rule 7.
VITE_RAZORPAY_KEY_ID=

# freeastroapi.com. There is NO key here on purpose — charts, panchang, the
# daily horoscope and place search all go through the `astro` Edge Function,
# which reads FREE_ASTRO_API_KEY from the project's function secrets. The
# browser never holds it (backend/INSTRUCTIONS.md rule 7).

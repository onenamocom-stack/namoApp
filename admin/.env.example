# Copy to .env.dev.local (dev project) and .env.prod.local (production).
# Both are gitignored by *.local. These are the PUBLIC url and anon key — the
# same values that ship in the phone app's bundle. Nothing elevated goes here:
# the API checks admin_users and the tier on every request.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
# The Django API, WITH the /v1 suffix. Its CORS_ALLOWED_ORIGINS must list
# http://localhost:5270 for the console to reach it.
VITE_DJANGO_API_URL=https://<api host>/v1

{
  "hosting": [
    {
      "target": "web",
      "public": "dist",
      "ignore": [
        "**/.DS_Store",
        "**/.git*"
      ],
      "rewrites": [
        {
          "source": "/",
          "run": {
            "serviceId": "namo-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/read/**",
          "run": {
            "serviceId": "namo-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/reels/**",
          "run": {
            "serviceId": "namo-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/shop/p/**",
          "run": {
            "serviceId": "namo-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/bhakti/s/**",
          "run": {
            "serviceId": "namo-api",
            "region": "asia-south1"
          }
        },
        {
          "regex": "^/shop/[ld]/[0-9a-fA-F-]{36}/?$",
          "run": {
            "serviceId": "namo-api",
            "region": "asia-south1"
          }
        },
        {
          "regex": "^/(u|consult)/[0-9a-fA-F-]{36}/?$",
          "run": {
            "serviceId": "namo-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/og/**",
          "run": {
            "serviceId": "namo-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/index.html",
          "destination": "/app.html"
        },
        {
          "source": "/onboarding",
          "destination": "/app.html"
        },
        {
          "source": "/horoscope",
          "destination": "/app.html"
        },
        {
          "source": "/notifications",
          "destination": "/app.html"
        },
        {
          "regex": "^/[A-Za-z0-9.-]{8,30}/?$",
          "run": {
            "serviceId": "namo-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "**",
          "destination": "/app.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=3600"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "/version.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/@(cards|deities|puja)/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        }
      ]
    },
    {
      "target": "pro",
      "public": "pro-redirect",
      "redirects": [
        {
          "regex": "^/pro/ring/(?P<id>[^/]+)$",
          "destination": "https://1namo.com/desk/ring/:id",
          "type": 302
        },
        {
          "source": "**",
          "destination": "https://1namo.com/desk",
          "type": 302
        }
      ]
    }
  ]
}
